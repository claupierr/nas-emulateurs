# Réglages du site émulateur — /srv/data/server/emulateurs/.env
# Lu au DÉMARRAGE du service : « sudo systemctl restart emulateurs-web » après édition.
# Pas de guillemets, pas de commentaire en fin de ligne (même règle que traitement_medias).

# Racine commune des ROM
EMU_ROMS=

# Dossier de chaque console : nom d'un sous-dossier de EMU_ROMS, ou chemin absolu.
# Laisser vide (ou supprimer la ligne) pour la reconnaissance automatique par le nom.
EMU_ROMS_NES=
EMU_ROMS_SNES=
EMU_ROMS_GB=
EMU_ROMS_MEGADRIVE=
EMU_ROMS_N64=E-N64
EMU_ROMS_NEOGEO=

# Emplacements de travail (rarement modifiés)
#EMU_SAVES=/srv/data/server/emulateurs/saves
#EMU_CONFIG=/srv/data/server/emulateurs/config
#EMU_SLOTS=6
#EMU_PORT=8097
